# secrets - DB credentials, Github OAuth/token, OpenAI key. Never commit this.
.env

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# local tooling artifacts (not part of the site)
.claude/

# logs, if anything ever writes them locally
*.log

# regenerated cache of public sitemap/feed responses (see app/cache.php) -
# runtime-generated, never meant to be committed
/app/cache

# maintenance kill-switch flag (see /admin/maintenance/toggle) - runtime
# state, never meant to be committed
/app/maintenance.flag
