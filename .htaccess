RewriteEngine On

# Never serve dotfiles directly (.env, .git/*, .htaccess itself) - this
# should already be unreachable via the front-controller routing below,
# but .env/.git sit right in the docroot so this stays explicit rather
# than relying on that alone.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# DreamHost's PHP setup strips the Authorization header before it ever
# reaches PHP - $_SERVER['HTTP_AUTHORIZATION'] is silently empty
# without this, which broke the /webhooks/sync bearer-token check.
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Serve real files/directories directly (assets, etc) - only route
# through the front controller when nothing on disk matches.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]
